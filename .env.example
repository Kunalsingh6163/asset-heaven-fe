# Server-only backend URL (used at runtime by /api/backend).
API_BASE_URL=https://mobulous-tech.vercel.app/api
# Local backend:
# API_BASE_URL=http://localhost:4500/api

# Optional Google web OAuth client ID. Also add this ID to backend GOOGLE_CLIENT_IDS.
# Set before building; allow the local and deployed frontend origins in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
